msgstr "•Expands your pocket size."

msgid "item_magic_pockets_i_title"
msgstr "Magic Pockets (I)"
msgid "item_magic_pockets_i_description"
msgstr "•Expands your pocket size."


msgid "item_salt_title"
msgstr "Salt"
msgid "item_salt_description"
msgstr "•Use (enemy health is below 50%): Salt the enemy wounds, dealing *{damage}* attack damage."

msgid "item_cheese_title"
msgstr "Cheese"
msgid "item_cheese_description"
msgstr "•Use (have poison): Eat the cheese, recovering *{recovery}* health and removing *{recovery}* poison."

msgid "item_shiv_title"
msgstr "Shiv"
msgid "item_shiv_description"
msgstr "•Use: Stab an enemy, dealing *{damage}* attack damage."

msgid "item_bandana_title"
msgstr "Bandana"
msgid "item_bandana_description"
msgstr "•Steal +1 item when defeating an enemy."

msgid "item_roots_title"
msgstr "Roots"
msgid "item_roots_description"
msgstr "•Every 2 seconds: Absorb nutrients, gaining *{recovery}* bonus health."

msgid "item_flower_title"
msgstr "Flower"
msgid "item_flower_description"
msgstr "•Connected items have +2 recovery."

msgid "item_pitchfork_title"
msgstr "Pitchfork"
msgid "item_pitchfork_description"
msgstr "•Use: Stab an enemy, dealing *{damage}* attack damage 3 times."

msgid "item_straw_hat_title"
msgstr "Straw Hat"
msgid "item_straw_hat_description"
msgstr "•Connected item dealt damage: Draw power from the hat, recovering *{recovery}* health."

