msgid "item_fisticuffs_title"
msgstr "Fisticuffs"
msgid "item_fisticuffs_description"
msgstr "•Use: Punch an enemy, dealing *{damage}* attack damage. Hits twice when below 50% health."

msgid "item_beer_title"
msgstr "Beer"
msgid "item_beer_description"
msgstr "•Battle start: Imbibe alcohol, applying *{status}* poison and increasing the damage of all your items by 5."