msgid "item_salt_title"
msgstr "Salt"
msgid "item_salt_description"
msgstr "•Your items have +1 health and shield gain."

msgid "item_cheese_title"
msgstr "Cheese"
msgid "item_cheese_description"
msgstr "•Use (have poison): Eat the cheese, recovering *{health_gain}* health and removing that much poison."

msgid "item_shiv_title"
msgstr "Shiv"
msgid "item_shiv_description"
msgstr "•Use: Stab an enemy, dealing *{damage}* attack damage."

msgid "item_bandana_title"
msgstr "Bandana"
msgid "item_bandana_description"
msgstr "•Steal +1 item when defeating an enemy."

msgid "item_roots_title"
msgstr "Roots"
msgid "item_roots_description"
msgstr "•Every 2 seconds: Absorb nutrients, gaining *{health_gain}* bonus health."

msgid "item_flower_title"
msgstr "Flower"
msgid "item_flower_description"
msgstr "•Connected items have +3 health gain."

msgid "item_pitchfork_title"
msgstr "Pitchfork"
msgid "item_pitchfork_description"
msgstr "•Use: Stab an enemy, dealing *{damage}* attack damage 3 times."

msgid "item_straw_hat_title"
msgstr "Straw Hat"
msgid "item_straw_hat_description"
msgstr "•Connected item dealt damage: Draw power from the hat, recovering *{health_gain}* health."

msgid "item_cow_slam_title"
msgstr "Technique: Cow Slam!"
msgid "item_cow_slam_description"
msgstr "•Use: Cow Slam! an enemy, dealing *{damage}* attack damage.[br]•Has +1 damage for each 8 health you have."

msgid "item_beef_title"
msgstr "Beef"
msgid "item_beef_description"
msgstr "•You have +25 health."

msgid "item_wood_title"
msgstr "Wood"
msgid "item_wood_description"
msgstr "•You have +25 shield."

msgid "item_wise_words_title"
msgstr "Technique: Wise Words"
msgid "item_wise_words_description"
msgstr "•Use: Speak wisely, progressing enemy fatigue by 0.75 seconds."

msgid "item_axe_title"
msgstr "Axe"
msgid "item_axe_description"
msgstr "•Use: Chop an enemy, dealing *{damage}* attack damage. Hits twice against shielded enemies."

msgid "item_pillow_title"
msgstr "Pillow"
msgid "item_pillow_description"
msgstr "•Fatigue start: Sleep on pillow, recovering *{health_gain}* health."

msgid "item_beehive_title"
msgstr "Beehive"
msgid "item_beehive_description"
msgstr "•Attack damage taken: Bees retaliate, applying *{status}* poison."

msgid "item_honeycomb_title"
msgstr "Honeycomb"
msgid "item_honeycomb_description"
msgstr "•Use: Eat honey, gaining *{health_gain}* bonus health."

msgid "item_stinger_title"
msgstr "Stinger"
msgid "item_stinger_description"
msgstr "•Use: Sting an enemy, dealing *{damage}* attack damage and applying *{status}* poison."

msgid "item_hunting_rifle_title"
msgstr "Hunting Rifle"
msgid "item_hunting_rifle_description"
msgstr "•Use (after 8 seconds): Shoot the enemy, dealing *{damage}* attack damage."

msgid "item_berries_title"
msgstr "Berries"
msgid "item_berries_description"
msgstr "•Has *{uses}* use(s).[br]•Use (health is below 50%): Eat the berries, recovering *{health_gain}* health."

msgid "item_fish_title"
msgstr "Fish"
msgid "item_fish_description"
msgstr "•Has *{uses}* use(s).[br]•Use: Eat the fish, gaining 1 dodge."

msgid "item_mushroom_title"
msgstr "Mushroom"
msgid "item_mushroom_description"
msgstr "•Use: Spread the spores, recovering *{health_gain}* health and applying *{status}* poison to an enemy."

msgid "item_snail_shell_title"
msgstr "Snail's Shell"
msgid "item_snail_shell_description"
msgstr "•Health gained: Harden shell, gaining shield equal to half the health gained."

msgid "item_sippy_straw_title"
msgstr "Sippy Straw"
msgid "item_sippy_straw_description"
msgstr "•Use: Sip enemy poison, gaining *{health_gain}* bonus health.[br]•Has +1 health gain for each poison the enemy has."

msgid "item_slime_title"
msgstr "Slime"
msgid "item_slime_description"
msgstr "•Connected item can only be used after 8 seconds have passed."

msgid "item_cauldron_title"
msgstr "Cauldron"
msgid "item_cauldron_description"
msgstr "•Use: Brew a potion, recovering *{health_gain}* health and applying *{status}* poison to an enemy.[br]•Connected item used: Add it to the cauldron, increasing health gain by 2 and status applied by 1."

msgid "item_magic_broom_title"
msgstr "Magic Broom"
msgid "item_magic_broom_description"
msgstr "•Battle start: Ride the broom, gaining *{status}* dodge."

msgid "item_cactus_title"
msgstr "Cactus"
msgid "item_cactus_description"
msgstr "•Attack damage taken: Cactus retaliates, dealing *{damage}* damage."

msgid "item_plasma_core_title"
msgstr "Plasma Core"
msgid "item_plasma_core_description"
msgstr "•Battle start: Burn bright, progressing fatigue by 5 seconds.[br]•You have +100 shield."

msgid "item_sunglasses_title"
msgstr "Sunglasses"
msgid "item_sunglasses_description"
msgstr "•Connected items have +100% damage during fatigue."

msgid "item_laser_eyes_title"
msgstr "Technique: Laser Eyes"
msgid "item_laser_eyes_description"
msgstr "•Use: Laser the enemy, dealing *{damage}* attack damage and reducing enemy max health by the same amount."

msgid "item_globe_title"
msgstr "Globe"
msgid "item_globe_description"
msgstr "•Use: Escape country, gaining *{shield_gain}* shield, 1 dodge, and progressing fatigue by 0.5 seconds."

msgid "item_spinach_title"
msgstr "Spinach"
msgid "item_spinach_description"
msgstr "•You have +5 health and your items have +1 damage."

msgid "item_deal_with_the_devil_title"
msgstr "Deal With The Devil"
msgid "item_deal_with_the_devil_description"
msgstr "•You have -25 health and can use +1 item at a time.[br]•Death: The Phobiarch takes your soul."

msgid "item_badge_title"
msgstr "Badge"
msgid "item_badge_description"
msgstr "•Battle start: Show the badge, stunning the enemy for 0.4 seconds.[br]•You have +5 shield."

msgid "item_sulphur_title"
msgstr "Sulphur"
msgid "item_sulphur_description"
msgstr "•Connected items have +3 damage after 8 seconds have passed."

msgid "item_riot_shield_title"
msgstr "Riot Shield"
msgid "item_riot_shield_description"
msgstr "•Use: Raise shield, gaining *{shield_gain}* shield and stunning the enemy for 0.2 seconds."

msgid "item_bulletproof_vest_title"
msgstr "Bulletproof Vest"
msgid "item_bulletproof_vest_description"
msgstr "•You have +25 shield.[br]•10 or more attack damage taken: The vest retaliates, stunning the enemy for 0.2 seconds."

msgid "item_baton_title"
msgstr "Baton"
msgid "item_baton_description"
msgstr "•Use: Clobber the enemy dealing *{damage}* attack damage and stunning for 0.2 seconds."

msgid "item_attack_drone_title"
msgstr "Attack Drone"
msgid "item_attack_drone_description"
msgstr "•Use or Rest: Call in a drone strike, dealing *{damage}* attack damage."

msgid "item_defense_drone_title"
msgstr "Defense Drone"
msgid "item_defense_drone_description"
msgstr "•Use or Rest: Call in a drone defense, gaining *{shield_gain}* shield."

msgid "item_nuclear_launch_codes_title"
msgstr "Nuclear Launch Codes"
msgid "item_nuclear_launch_codes_description"
msgstr "•Fatigue start: Star nuclear war, dealing *{damage}* attack damage and applying *{status}* poison."

# statuses

msgid "status_poison_title"
msgstr "Poison"
msgid "status_poison_description"
msgstr "•Every 2 seconds: Take 1 damage for each stack of poison."

msgid "status_burn_title"
msgstr "Burn"
msgid "status_burn_description"
msgstr "•Every half a second: Take 1 damage for each stack of burn then lose 10% of your burn."

msgid "status_dodge_title"
msgstr "Dodge"
msgid "status_dodge_description"
msgstr "•Attack incoming: Lose 1 stack of dodge and avoid the attack."

# knight

msgid "item_zweihander_title"
msgstr "Zweihander"
msgid "item_zweihander_description"
msgstr "•Use: Slash an enemy, dealing *{damage}* attack damage. Then, if the enemy health is below 20%, execute your foe."

msgid "item_whetstone_title"
msgstr "Whetstone"
msgid "item_whetstone_description"
msgstr "•Connected items have +15% damage."

msgid "message_execution"
msgstr "EXECUTION"

# chef

msgid "item_frying_pan_title"
msgstr "Frying Pan"
msgid "item_frying_pan_description"
msgstr "•Use: Bludgeon an enemy, dealing *{damage}* attack damage.[br]•Connected items have +100% health gain."

msgid "item_milk_title"
msgstr "Milk"
msgid "item_milk_description"
msgstr "•Use (health is below 50%): Sip the milk, recovering *{health_gain}* health."

# bomber

msgid "item_bomb_title"
msgstr "Bomb"
msgid "item_bomb_description"
msgstr "•After 5 seconds: Explode an enemy, dealing *{damage}* attack damage and stunning them for 2 seconds."

msgid "item_matches_title"
msgstr "Matches"
msgid "item_matches_description"
msgstr "•Use: Set an enemy on fire, dealing *{damage}* attack damage.[br]•Connected items have +25% damage."

# bum

msgid "item_fisticuffs_title"
msgstr "Fisticuffs"
msgid "item_fisticuffs_description"
msgstr "•Use: Punch an enemy, dealing *{damage}* attack damage. Hits twice when below 50% health."

msgid "item_beer_title"
msgstr "Beer"
msgid "item_beer_description"
msgstr "•Has *{uses}* use(s).[br]•Use: Imbibe alcohol, applying *{status}* poison and increasing the damage of all your items by 4."
